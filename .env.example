PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=BeMclass

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_HOURS=24
JWT_REMEMBER_DAYS=30

# Google OAuth Client ID (Android / iOS / Web serverClientId, pisahkan dengan koma jika lebih dari satu)
GOOGLE_CLIENT_ID=


# Flask AI Service (mclass-ai)
AI_BASE_URL=http://127.0.0.1:5000
AI_INTERNAL_TOKEN=dev-internal-token
AI_TIMEOUT_MS=5000
AI_DEV_FALLBACK=false
FACE_MATCH_THRESHOLD=0.75
